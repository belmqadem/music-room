# Mobile .env — read by Expo at bundle time. Copy to mobile/.env (gitignored):
#   cp mobile/.env.example mobile/.env
# Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle and visible to
# users: never put secrets here.

# Default backend base URL. It can be changed at RUNTIME from the app's
# settings (the subject requires this), so this is only the first-launch value.
# A phone cannot reach "localhost" on your computer: use your machine's LAN IP,
# e.g. http://192.168.1.20:3000 (Android emulator: http://10.0.2.2:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Google and Facebook sign-in (ADR-033; optional: without them the buttons are not shown) ---
# They need a development build (`npm run ios` / `npm run android`); Expo Go and the web build do not
# include the native SDKs. These are public identifiers, not secrets, but they belong to your
# Google / Facebook projects, so they live here and not in the repo.
#
# Google Cloud console > Credentials. The ID token is issued for the WEB client id, so the backend's
# GOOGLE_CLIENT_IDS must contain it. Android also needs an Android client with package
# com.musicroom.app and the SHA-1 of the signing key (debug key for development builds).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Facebook app > Settings > Basic (app id; must equal the backend's FACEBOOK_APP_ID) and
# Settings > Advanced (client token). The client token is only used when the app is built.
EXPO_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
