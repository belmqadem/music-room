{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/backend/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node-pg-migrate -m src/db/migrations --migration-file-language sql",
    "migrate:create": "node-pg-migrate create -m src/db/migrations --migration-file-language sql"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
