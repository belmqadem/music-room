# Root .env — used by docker-compose AND the backend. Copy to .env (gitignored):
#   cp .env.example .env
# Never commit real values. Change the placeholders below.

# --- Postgres container (docker-compose) ---
# Superuser name created on first start of the container.
POSTGRES_USER=musicroom
# Superuser password. Placeholder only: choose your own.
POSTGRES_PASSWORD=change-me
# Database created on first start.
POSTGRES_DB=musicroom
# Host port mapped to the container's 5432.
POSTGRES_PORT=5432

# --- Redis container (docker-compose) ---
# Host port mapped to the container's 6379.
REDIS_PORT=6379

# --- Backend ---
# development | test | production
NODE_ENV=development
# Port the HTTP + Socket.io server listens on.
PORT=3000
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Postgres connection string. Must match the POSTGRES_* values above.
DATABASE_URL=postgres://musicroom:change-me@localhost:5432/musicroom
# Redis connection string. Must match REDIS_PORT above.
REDIS_URL=redis://localhost:6379
# Secret used to sign access tokens (HS256). At least 32 characters, random.
# Generate one with: openssl rand -base64 48
# Changing it logs everyone out. Placeholder only: choose your own.
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

# --- Social sign-in (optional; a provider without its settings is disabled) ---
# Google: comma-separated OAuth client ids (iOS, Android, Web) from Google Cloud Console.
# They are public identifiers, not secrets.
GOOGLE_CLIENT_IDS=
# Facebook: from developers.facebook.com. Set BOTH or neither.
FACEBOOK_APP_ID=
# SECRET: server only. Never put it in the mobile app or the repo.
FACEBOOK_APP_SECRET=

# --- Web client ---
# Browser origins allowed to call the API (CORS), comma-separated, no trailing slash, never "*".
# The Expo web dev server runs on 8081. Empty = no browser origin allowed (mobile still works).
ALLOWED_ORIGINS=http://localhost:8081
