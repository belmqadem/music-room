#!/bin/sh
# Rejects commit messages that are not Conventional Commits.
# Enabled by `make install` via: git config core.hooksPath .githooks
# Format: <type>(<optional scope>)<!>: <description>
# Merge/revert/fixup commits generated by git are allowed through.

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|test|refactor|perf|build|ci|style)(\([a-z0-9-]+\))?!?: .{1,100}$'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit message rejected: not a Conventional Commit." >&2
  echo "  Expected: <type>(<scope>): <description>" >&2
  echo "  Types: feat fix chore docs test refactor perf build ci style" >&2
  echo "  Example: feat(track-vote): add ranking endpoint" >&2
  echo "  Got:     $first_line" >&2
  exit 1
fi
